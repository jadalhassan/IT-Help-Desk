# Backend production-style environment example
ASPNETCORE_ENVIRONMENT=Production
DemoMode=false
DatabaseProvider=Sqlite
ConnectionStrings__DefaultConnection=Data Source=/data/helpdesk.db
Jwt__Issuer=HelpDesk.Api
Jwt__Audience=HelpDesk.Frontend
Jwt__Secret=replace-with-a-unique-random-secret-of-at-least-32-characters
Cors__AllowedOrigins=http://localhost:5173
Uploads__MaxFileSizeMb=10

# Used only when the database has no users and DemoMode=false.
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=ChangeMe-Strong-12345
BootstrapAdmin__FullName=System Administrator

# Optional AI provider examples
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
